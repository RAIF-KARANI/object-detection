# Virtual environment (several GB, rebuilt from requirements.txt)
.venv/

# Python cache files
__pycache__/
*.pyc

# Model weights (downloaded automatically by ultralytics on first run)
*.pt
*.onnx
*.engine

# Input videos can be large: keep the folder, ignore its contents
videos/*
!videos/.gitkeep

# Annotated output videos are large; CSVs and screenshots ARE committed
outputs/*.mp4
outputs/*.avi

# Editor / OS clutter
.vscode/
Thumbs.db
